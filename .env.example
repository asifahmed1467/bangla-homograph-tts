# Copy this file to .env and change values there. Nothing in the code has to be edited.
# docker compose reads .env automatically. Without Docker, set the variables in the shell
# (cmd: set HG_PORT=8080   PowerShell: $env:HG_PORT="8080") before running python.
# Every line can be left out: the value shown is the default.

# ---- web app (web_app.py, Docker) ----
HG_PORT=7860                 # port of the web page (Docker publishes the same port)
HG_HOST=127.0.0.1            # address to listen on; Docker always uses 0.0.0.0
HG_DEFAULT_MODEL=gemma       # model selected when the page opens: gemma or sahajbert
HG_TAG_MODE=before           # how the Gemma adapter was trained: before, trigger or none
HG_MAX_TAGS=2                # <hg> tags corrected per sentence (the models were trained with at most 2)
HG_ASR_RULE=1                # 0 = switch off the keyword safety net for আসর/আসরে/আসরের
HG_ASR_WINDOW=4              # words on each side of the tagged word the safety net looks at
HG_SHARE=0                   # 1 = also print a temporary public gradio.live link (needs internet)
HG_FAKE=0                    # 1 = stand-in answers, only to check the page

# ---- model locations ----
# Without Docker: default is the models/ folder next to web_app.py.
# In Docker the models are baked into the image at /models; only change these if you mount other models.
# HG_MODELS_DIR=models
# HG_GEMMA_ADAPTER=models/gemma_cpu_lora
# HG_SAHAJBERT_MODEL=models/sahajbert
# HG_GEMMA_BASE=unsloth/gemma-3-270m-it   # base model when the adapter has no base_model.txt (without Docker; the image has its base baked in)

# ---- training (gemma_training/train_cpu.py) ----
# HG_GEMMA_EPOCHS=2
# HG_GEMMA_BATCH=4
# HG_GEMMA_OUT=gemma_cpu_lora

# ---- sahajBERT (sahajbert/config.json; HG_<KEY> overrides any key) ----
# HG_EPOCHS=5
# HG_BATCH_SIZE=8
# HG_LR=2e-5
# HG_MAX_LENGTH=128
# HG_THREADS=4

# ---- model selector (run.py) ----
# HG_MODEL=gemma             # gemma or sahajbert; wins over config.json
